{
  "__inputs": [
    {
      "name": "DS_GRAFANACLOUD_TSHEPANGAMIR_PROM",
      "label": "grafanacloud-tshepangamir-prom",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Fraud Platform — scoring latency, decision distribution, fraud score histogram, PSI drift",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(fraud_decisions_total{service_name=\"fraud-scorer\"}[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "p95 Scoring Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 100 }
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fraud_score_latency_ms_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p95 ms"
        }
      ]
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "p99 Scoring Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 200 }
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(fraud_score_latency_ms_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Error Rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 0.01 }
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_duration_milliseconds_count{service_name=\"fraud-scorer\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(fraud_decisions_total{service_name=\"fraud-scorer\"}[5m])), 1)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries",
      "title": "Scoring Latency Percentiles (ms)",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(fraud_score_latency_ms_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(fraud_score_latency_ms_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fraud_score_latency_ms_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "piechart",
      "title": "Decision Distribution",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "options": {
        "pieType": "donut",
        "legendDisplayMode": "table",
        "legendPlacement": "right"
      },
      "targets": [
        {
          "expr": "sum(increase(fraud_decisions_total{service_name=\"fraud-scorer\"}[1h])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "type": "timeseries",
      "title": "Fraud Score Distribution Over Time",
      "description": "p50/p90/p99 of fraud_score — rising p90 signals distribution shift",
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANACLOUD_TSHEPANGAMIR_PROM}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(fraud_score_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p50 score"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(fraud_score_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p90 score"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fraud_score_bucket{service_name=\"fraud-scorer\"}[5m])) by (le))",
          "legendFormat": "p99 score"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["fraud", "ml", "scoring"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fraud Platform — Scoring Service",
  "uid": "fraud-platform-scoring",
  "version": 1
}
